```gitignore
# Dependencies
node_modules/
.jest/
.nyc_output/
coverage/
.npm/
.yarn/

# Build outputs
dist/
build/
.next/
out/
lib/
esm/
cjs/

# TypeScript/JavaScript
*.tsbuildinfo
*.js.map
*.jsx.map
*.ts.map

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# OS generated
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
```